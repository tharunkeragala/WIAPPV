# Admin credentials
ADMIN_PASSWORD=change-this-password
ADMIN_API_TOKEN=change-this-long-random-token

# Set to your production Vercel URL, e.g. https://your-app.vercel.app
PUBLIC_BASE_URL=http://localhost:3000

# Auto-injected by the "Upstash for Redis" Vercel Marketplace integration —
# you won't set these by hand in the dashboard, but you do need them in
# .env.local for local `vercel dev` (run `vercel env pull .env.local`).
KV_REST_API_URL=
KV_REST_API_TOKEN=
